# Dependencies and package-manager caches
node_modules/
.npm-cache-verify/

# Vite and production output
dist/
dev-dist/
.vite/
*.local

# Generated TypeScript build metadata
node_modules/.tmp/

# Tests and reports
coverage/
playwright-report/
test-results/
blob-report/

# Emscripten and CMake build output
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
wasm/build*/
wasm/generated/
public/wasm/

# Environment files; keep an explicit template when one exists
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Local scratch files
.tools/
.tmp/
tmp/

# UI audit screenshots and manifests
/ui-audit-*/
/ui-audit-current.png

# Local release artifacts
/release/

# Do not ignore third_party/: GPL-covered source used for a release must ship.
