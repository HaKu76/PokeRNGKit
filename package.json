{
  "name": "pokerngkit",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first Pokemon RNG toolkit for the web.",
  "x-brandStatus": "english-name-confirmed",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "npm run wasm:build && vite",
    "dev:ui": "vite --mode ui --host 127.0.0.1 --port 5173 --strictPort",
    "dev:web": "vite",
    "build": "npm run wasm:build && npm run build:web",
    "build:ui": "tsc -b && vite build --mode ui",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:ui": "npm run build:ui && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:changed": "node scripts/format-changed.mjs",
    "format:files": "prettier --write --ignore-unknown",
    "format:check": "prettier --check .",
    "wasm:doctor": "node scripts/wasm.mjs doctor",
    "wasm:configure": "node scripts/wasm.mjs configure",
    "wasm:build": "node scripts/wasm.mjs build",
    "wasm:test:native": "node scripts/wasm.mjs test-native",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:web",
    "verify:full": "npm run verify && npm run wasm:test:native && npm run wasm:build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "i18next": "^26.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "cmake-runtime": "4.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "ninja-runtime": "1.13.2",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.10"
  }
}
